<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 자동 백업·기기 이전. backup_rules.xml과 같은 내용이다 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
